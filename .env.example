# =============================================================================
# Svvayam Live Consultation - Environment Variable Template
# Google Backend (Firebase & Google Cloud Platform)
# =============================================================================

# 1. Firebase Client Configuration (from Firebase Console > Project Settings > General > Your apps > Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 2. Recommended Service Region for India-based users (low latency & in-region residency)
# Note: Firestore database location is chosen once during initial database creation in Firebase Console.
# Default recommended: asia-south1 (Mumbai) or asia-south2 (Delhi).
VITE_GOOGLE_CLOUD_REGION=asia-south1

# 3. Trusted Administrator Account
# Super Administrator access is strictly bound to marketing@svvayam.com via Firebase Authentication
# and enforced in firestore.rules. Administrative privileges are never granted from client-exposed
# environment variables or client-writable role fields. Team administrators are managed securely
# through the Admin Team portal by authenticated super administrators.

# 4. Optional: Google Sheets Sync (Configured in Cloud Functions environment or Secret Manager)
# GOOGLE_SHEETS_SPREADSHEET_ID=
# GOOGLE_SERVICE_ACCOUNT_KEY=

# 5. Legacy Supabase Configuration (Maintained during migration window for seamless rollback)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
